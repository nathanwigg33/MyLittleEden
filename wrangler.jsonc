{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mylittleeden",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // A static site: Cloudflare serves everything in ./public. No database needed —
  // each player's garden is saved on their own device.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
